      "isDeleted": false,
      "boundElements": [
        {
          "id": "bYAIWbw2dJKx5mftpuE8i",
          "type": "arrow"
        }
      ],
      "updated": 1787897188771,
      "link": null,
      "locked": false,
      "text": "Все шаги логируем в БД, это позволяет\nвернуться на любой этап обработки",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Все шаги логируем в БД, это позволяет\nвернуться на любой этап обработки",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
