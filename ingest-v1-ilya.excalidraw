      "updated": 1787897188771,
      "link": null,
      "locked": false,
      "text": "Определяем расширение файла,\nзапускаем скрипт декомпозиции этого документа.\nНапример PDF - и скрипт на основе библиотеки PyMyPDF  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Определяем расширение файла,\nзапускаем скрипт декомпозиции этого документа.\nНапример PDF - и скрипт на основе библиотеки PyMyPDF  ",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
