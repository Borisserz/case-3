    {
      "id": "76KgypHQz_6n8a_EkxUDf",
      "type": "text",
      "x": -4313.0287420625555,
      "y": -3057.3654525044244,
      "width": 459.61968994140625,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "697sGFyv2WnKoKGCimlN7"
      ],
      "frameId": null,
      "index": "bNFnV",
      "roundness": null,
      "seed": 835052135,
      "version": 275,
      "versionNonce": 685613921,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787897190451,
      "link": null,
      "locked": false,
      "text": "Модуль распознавания пустых общих\nприветствий\n1. Приводим к нижнему регистру убирая знаки\nприпенания.\n2. Если полное совпадение со словами:\n['привет', 'как дела', 'спасибо', 'пока'] - сразу\nотправляем в LLM\n3. Прогоняем через NER NLP\n4. Считаем количество слов.if word_count > 4:\ninformational_score += 1\n5. Создаем словарь слов действий:['что', 'кто',\n'где', 'когда', 'почему', 'как', 'какой', 'найди',\n'расскажи', 'объясни', 'сравни', 'проанализируй']\nЕсли встречаются:informational_score += 1\n6.Извлекаем из результатов NLP-обработки и\nNER-сущности, и POS-теги if (len(ner_entities)\n> 0) or (len(significant_nouns) > 0): score += 2\ninformational_score += 2\n7. if(informational_score>=3){...или...}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rdGlNSc7jt1gOM7ypPRzP",
      "originalText": "Модуль распознавания пустых общих приветствий\n1. Приводим к нижнему регистру убирая знаки припенания.\n2. Если полное совпадение со словами:['привет', 'как дела', 'спасибо', 'пока'] - сразу отправляем в LLM\n3. Прогоняем через NER NLP\n4. Считаем количество слов.if word_count > 4: informational_score += 1\n5. Создаем словарь слов действий:['что', 'кто', 'где', 'когда', 'почему', 'как', 'какой', 'найди', 'расскажи', 'объясни', 'сравни', 'проанализируй'] Если встречаются:informational_score += 1\n6.Извлекаем из результатов NLP-обработки и NER-сущности, и POS-теги if (len(ner_entities) > 0) or (len(significant_nouns) > 0): score += 2 informational_score += 2\n7. if(informational_score>=3){...или...}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
