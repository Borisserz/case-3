    {
      "id": "a4ZqEPEbkU7xjeGq_6yHZ",
      "type": "text",
      "x": -9541.591770792631,
      "y": -1400.3039701203368,
      "width": 531.4196166992188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
