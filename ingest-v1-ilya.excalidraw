    {
      "id": "ADvcb7CoPUlnq-eV9kLrK",
      "type": "text",
      "x": -4324.2286932344305,
      "y": -2495.7653548481744,
      "width": 490.67974853515625,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
