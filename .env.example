# Скопируй в .env рядом с docker-compose.yml. Это порты контейнеров.
# Qwen и картинки сюда не писать: они в backend/.env и stimulsoft/.env.
# На Windows-хосте 8000 занят image-моделью, 8080 — Qwen. Их здесь не занимать.
# У frontend своего .env нет.

# Порт API внутри сети Docker. Nginx ходит на backend:${CASE3_PORT}.
CASE3_PORT=8000
# Порт API на хосте. Снаружи Swagger: http://127.0.0.1:8010/docs
CASE3_BACKEND_HOST_PORT=8010

CASE3_FRONTEND_HOST_PORT=5173

VIEWER_PORT=8040
CASE3_STIMULSOFT_HOST_PORT=8040
DASHBOARD_PUBLIC_URL=http://127.0.0.1:8040
