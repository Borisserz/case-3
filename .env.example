# Copy to .env
VISION_API_BASE_URL=http://192.168.x.x:8080
# VISION_API_KEY=
# VISION_MODEL=
VISION_TIMEOUT_S=300
VISION_REASONING=low
CASE3_IMAGE=case-3:tex

# Kandinsky / image API (OpenAI-like POST .../v1/images/generations)
# 0 = text-only, no image slots
KANDINSKY_MAX_IMAGES=2
KANDINSKY_API_BASE_URL=http://192.168.x.x:8081
# KANDINSKY_API_KEY=
# KANDINSKY_MODEL=
KANDINSKY_ENDPOINT_PATH=/v1/images/generations
KANDINSKY_SIZE=1024x1024
KANDINSKY_TIMEOUT_S=120
