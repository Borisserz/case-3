# Copy to .env
VISION_API_BASE_URL=http://192.168.x.x:8080
# VISION_API_KEY=
# VISION_MODEL=
VISION_TIMEOUT_S=300
# low/medium/high = thinking; если пустой ответ / нет \\documentclass → off
VISION_REASONING=off
CASE3_IMAGE=case-3:tex

# Kandinsky / image API (OpenAI-like POST .../v1/images/generations)
# 0 = text-only, no image slots
KANDINSKY_MAX_IMAGES=2
KANDINSKY_API_BASE_URL=http://192.168.x.x:8081
# KANDINSKY_API_KEY=
# KANDINSKY_MODEL=
KANDINSKY_ENDPOINT_PATH=/v1/images/generations
KANDINSKY_SIZE=1024x1024
KANDINSKY_TIMEOUT_S=120
# Prefer b64_json. Set 1 only if API returns public https URLs (SSRF-protected).
KANDINSKY_ALLOW_URL_DOWNLOAD=0

# Единственная переменная бюджета графиков (0 = off). Не дублировать другими именами.
CASE3_MAX_CHARTS=3
CASE3_CHART_TIMEOUT_S=15
