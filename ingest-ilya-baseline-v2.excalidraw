  },
  {
   "id": "t203",
   "type": "text",
   "x": -20,
   "y": 2594,
   "width": 1172.16,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b4c",
   "roundness": null,
   "seed": 771006270,
   "version": 2,
   "versionNonce": 371768418,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1790428767892,
   "link": null,
   "locked": false,
   "customData": {
    "lane": "ilya"
   },
   "text": "Оригинал: «Загрузка данных на сервер + обработка» — internal/schema-ilya/ingest-v1-ilya.excalidraw (секция ingest, без query/RRAG). Тексты —\nдословно с доски, опечатки сохранены («синхронизаниции», «Загрука», «PyMyPDF», «Контекстулизация», «идтив»); три самых длинных абзаца сокращены «…»\n(без потери смысла — полные тексты в docs/ilya-ingest-schema-walkthrough.md). Раскладка причёсана для читаемости, состав блоков и связи — как у Ильи.\nЦвета стрелок — его: синие → вектор, зелёные → лексика, оранжевые → граф, чёрные → PostgreSQL. Сверка с оригиналом: docs/ilya-baseline-vs-original.md",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Оригинал: «Загрузка данных на сервер + обработка» — internal/schema-ilya/ingest-v1-ilya.excalidraw (секция ingest, без query/RRAG). Тексты —\nдословно с доски, опечатки сохранены («синхронизаниции», «Загрука», «PyMyPDF», «Контекстулизация», «идтив»); три самых длинных абзаца сокращены «…»\n(без потери смысла — полные тексты в docs/ilya-ingest-schema-walkthrough.md). Раскладка причёсана для читаемости, состав блоков и связи — как у Ильи.\nЦвета стрелок — его: синие → вектор, зелёные → лексика, оранжевые → граф, чёрные → PostgreSQL. Сверка с оригиналом: docs/ilya-baseline-vs-original.md",
   "autoResize": true,
   "lineHeight": 1.25
  },
