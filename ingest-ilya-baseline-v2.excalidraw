   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "il_img",
   "originalText": "Изображение, фото,\nсхемы, графики,\nдиаграммы",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
