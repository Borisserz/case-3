  {
   "id": "FOkD1N3C0oLTkc_aH0bUV",
   "type": "text",
   "x": 350.3681640625,
   "y": 3249.25,
   "width": 89.263671875,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
